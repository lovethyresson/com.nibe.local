index 0000000..7c8acda
--- /dev/null
+++ b/dev/fit-wind.mjs
@@ -0,0 +1,79 @@
+// Does the wind term earn its place (lib/autopilot/model.ts `windLoss`)? Fits the house exactly as the app
+// does (lib/autopilot/house.ts) at rolling cut-offs, twice: with the wind in the slots and with it taken
+// out. Each fit sees only the history before its cut-off; it then predicts open-loop on the heat actually
+// delivered. Prints what each learned, the gaps (measured minus predicted) at 24 h, 48 h and day 5, and
+// the windy-window scores at 6 h and 24 h that the gate would use. Reads only.
+//
+//   node --import tsx dev/fit-wind.mjs <url or file> [--from "2026-11-12 00:00"] [--step 12]
+import fs from 'node:fs';
+import {History, applyJournal} from '../lib/autopilot/history.ts';
+import {fitHouse, modelSlotsFromHistory, pumpFromHistory} from '../lib/autopilot/house.ts';
+import {fitSeries, stepHouse, windScore, WINDY_ABOVE} from '../lib/autopilot/model.ts';
+
+const source = process.argv[2];
+const option = (name, fallback) => {
+    const at = process.argv.indexOf(`--${name}`);
+    return at > 0 ? process.argv[at + 1] : fallback;
+};
+const read = async (path) => (/^https?:/.test(path)
+    ? fetch(path).then(async (r) => (r.ok ? Buffer.from(await r.arrayBuffer()) : undefined))
+    : fs.promises.readFile(path).catch(() => undefined));
+const file = await read(source) ?? Buffer.alloc(0);
+const history = History.deserialize(file);
+if (!history) { console.error('Not a history file this version can read.'); process.exit(1); }
+const journal = await read(`${source}.journal`);
+if (journal?.length) applyJournal(history, journal, History.fieldCount(file));
+
+const SLOT_MS = 15 * 60_000;
+const slotAt = (local) => Math.floor(new Date(local.replace(' ', 'T')).getTime() / SLOT_MS);
+const local = (slot) => new Date(slot * SLOT_MS).toLocaleString('sv-SE').slice(5, 16);
+const withWind = modelSlotsFromHistory(history);
+const noWind = withWind.map((s) => { const {wind: _w, ...inputs} = s.inputs; return {...s, inputs}; });
+const pump = pumpFromHistory(history);
+const mean = (a) => (a.length ? a.reduce((x, y) => x + y, 0) / a.length : NaN);
+const rms = (a) => Math.sqrt(mean(a.map((x) => x * x)));
+const f = (v, d = 2, w = 6) => (Number.isFinite(v) ? v.toFixed(d) : '-').padStart(w);
+
+// Open-loop from the fit's state on what was delivered: the mean gap over each horizon.
+const gaps = (p, state, slots) => {
+    let ti = state.ti, tm = state.tm;
+    const out = {24: [], 48: [], 120: []};
+    for (const s of slots) {
+        if (s.slot <= state.slot) continue;
+        if (s.slot > state.slot + 120 * 4) break;
+        [ti, tm] = stepHouse(p, ti, tm, s.inputs);
+        if (!Number.isFinite(s.ti)) continue;
+        const h = (s.slot - state.slot) / 4;
+        if (h <= 24) out[24].push(s.ti - ti);
+        if (h <= 48) out[48].push(s.ti - ti);
+        if (h > 96) out[120].push(s.ti - ti);
+    }
+    return {g24: mean(out[24]), g48: mean(out[48]), g120: out[120].length > 48 ? mean(out[120]) : NaN};
+};
+const windOver = (slot, hours) => mean(withWind.filter((s) => s.slot > slot && s.slot <= slot + hours * 4)
+    .map((s) => s.inputs.wind).filter((w) => w !== undefined));
+
+const score = {wind: [], none: []};
+console.log('cut          windLoss W/K/(m/s)  ref m/s  next 24h wind   24h gap wind/none   48h gap wind/none   day-5 gap wind/none   windy 6h on/off   windy 24h on/off');
+for (let cut = slotAt(option('from', '2026-11-12 00:00')); cut <= withWind.at(-1).slot; cut += Number(option('step', '12')) * 4) {
+    const a = fitHouse(withWind.filter((s) => s.slot < cut), {system: 'unknown', era: 'unknown'}, pump.lever, pump);
+    const b = fitHouse(noWind.filter((s) => s.slot < cut), {system: 'unknown', era: 'unknown'}, pump.lever, pump);
+    if (!a.params || !a.state || !b.params || !b.state) continue;
+    const ga = gaps(a.params, a.state, withWind), gb = gaps(b.params, b.state, noWind);
+    const next = windOver(a.state.slot, 24);
+    score.wind.push({...ga, next, ref: a.params.windRef}); score.none.push({...gb, next, ref: a.params.windRef});
+    const train = withWind.filter((s) => s.slot < cut);
+    const states = fitSeries(train, 'unknown', 'unknown', {warmupSlots: Math.min(3 * 96, train.length)}).states;
+    const w6 = windScore(a.params, train.slice(-7 * 96), states, 24), w24 = windScore(a.params, train.slice(-7 * 96), states, 96);
+    console.log(local(cut), f(a.params.windLoss * 1000, 1, 12), f(a.params.windRef, 1, 15), f(next, 1, 13),
+        f(ga.g24, 2, 12), f(gb.g24, 2, 7), f(ga.g48, 2, 13), f(gb.g48, 2, 7), f(ga.g120, 2, 15), f(gb.g120, 2, 7),
+        `${f(w6.rmseOn, 2, 9)}/${f(w6.rmseOff, 2, 4)} (${w6.windows})`, `${f(w24.rmseOn, 2, 8)}/${f(w24.rmseOff, 2, 4)} (${w24.windows})`);
+}
+const summary = (rows, pick) => rows.map(pick).filter(Number.isFinite);
+console.log('\nrms of the gap over all cut-offs, and over cut-offs whose next 24 h was windy (≥ ref + ' + WINDY_ABOVE + ' m/s)');
+console.log('model      24 h    48 h   day 5   | windy 24 h  48 h');
+for (const [name, rows] of Object.entries(score)) {
+    const windy = rows.filter((r) => r.next >= r.ref + WINDY_ABOVE);
+    console.log(name.padEnd(8), f(rms(summary(rows, (r) => r.g24))), f(rms(summary(rows, (r) => r.g48)), 2, 7), f(rms(summary(rows, (r) => r.g120)), 2, 7),
+        '  |', f(rms(summary(windy, (r) => r.g24)), 2, 9), f(rms(summary(windy, (r) => r.g48)), 2, 6), `  (${windy.length} windy cut-offs)`);
+}
