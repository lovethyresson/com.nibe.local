        {
          "id": "alarm_log",
          "type": "label",
          "label": {
            "en": "Latest alarm",
            "sv": "Senaste larmet",
            "de": "Letzter Alarm",
            "nl": "Laatste alarm",
            "no": "Siste alarm",
            "da": "Seneste alarm"
          },
          "hint": {
            "en": "The most recent alarm reported by the heat pump. For the full history — with NIBE's cause and suggested action for each alarm — open this app's own settings: Homey app → More → Apps → Nibe Live → Configure.",
            "sv": "Det senaste larmet som värmepumpen rapporterat. För hela historiken — med NIBE:s orsak och åtgärd för varje larm — öppna appens egna inställningar: Homey-appen → Mer → Appar → Nibe Live → Konfigurera.",
            "de": "Der jüngste von der Wärmepumpe gemeldete Alarm. Die vollständige Historie — mit NIBEs Ursache und empfohlener Maßnahme je Alarm — finden Sie in den Einstellungen dieser App: Homey-App → Mehr → Apps → Nibe Live → Konfigurieren.",
            "nl": "Het meest recente alarm van de warmtepomp. De volledige historie — met NIBE's oorzaak en aanbevolen actie per alarm — vind je in de instellingen van deze app: Homey-app → Meer → Apps → Nibe Live → Configureren.",
            "no": "Den nyeste alarmen varmepumpen har rapportert. Hele historikken — med NIBEs årsak og tiltak for hver alarm — finner du i appens egne innstillinger: Homey-appen → Mer → Apper → Nibe Live → Konfigurer.",
            "da": "Den seneste alarm som varmepumpen har rapporteret. Hele historikken — med NIBEs årsag og anbefalede handling for hver alarm — finder du i appens egne indstillinger: Homey-appen → Mere → Apps → Nibe Live → Konfigurer."
          },
          "value": ""
        }
      ]
    }
